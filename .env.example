# ============================================
# RAG Agent 环境变量模板
# ============================================
# 复制本文件为 .env.docker 并填入真实值
# docker-compose.yml 会通过 env_file 自动加载
#
# 说明: 当前代码中 API 鉴权 Key 从 config/agent_config.json 读取
#       环境变量方式尚未接入，请修改 config/agent_config.json 中的 api.key

# ----- 研究会话 Cookie（部署安全配置）-----
# HTTPS 部署保持 true（默认）；仅受控本地 HTTP 调试时明确设为 false。
# 非 true/false 的值会拒绝登录，避免拼写错误静默降低 Cookie 安全属性。
RESEARCH_SESSION_COOKIE_SECURE=true

# ----- DashScope (通义千问) API Key -----
# 必填。用于调用 LLM 模型（qwen-max / qwen-plus 等）
# 获取地址: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ----- LangSmith 监控（可选）-----
# 用于追踪和评估 Agent 推理过程
# 获取地址: https://smith.langchain.com/
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=financial-rag-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
