# 将此文件重命名为 .env，并填入你自己的 API 密钥
# 不使用的服务可以留空，但 DashScope 是必需的

# ===== 必需 =====
# 阿里云 DashScope API Key（用于 Embedding 向量化和 LLM 问答）
# 获取地址：https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=你的DashScope_API_Key

# ===== PDF 解析 =====
# MinerU API Key（用于 PDF 转 Markdown，从 OpenXLab 平台获取）
# 获取地址：https://mineru.net/ 或 https://openxlab.org.cn/
MINERU_API_KEY=你的MinerU_API_Key

# ===== 可选 =====
# OpenAI API Key（使用 GPT 系列模型时需要）
OPENAI_API_KEY=

# Gemini API Key（使用 Google Gemini 模型时需要）
GEMINI_API_KEY=

# Jina API Key（使用 Jina Reranker 重排时需要）
# 获取地址：https://jina.ai/reranker/
JINA_API_KEY=
