{
    "_comment": "RAG-Agent 行为配置文件",
    "agent": {
        "max_steps": 10,
        "llm_timeout": 60,
        "tool_timeout": 30,
        "temperature": 0.3,
        "max_retries": 1,
        "model": "qwen-max",
        "models": {
            "_comment": "按 Agent 角色分配模型，未指定时回退到 agent.model",
            "orchestrator": "qwen-max",
            "data": "qwen-turbo",
            "calc": "qwen-plus",
            "compare": "qwen-max",
            "chart": "qwen-max",
            "verify": "qwen-plus",
            "router": "qwen-turbo"
        }
    },
    "multi_agent": {
        "_comment": "多 Agent 模式容错与超时配置（步骤 0.1 仅定义配置项，使用逻辑在后续步骤实现）",
        "worker_max_retries": 1,
        "worker_timeout": 30,
        "orchestrator_timeout": 120,
        "continue_on_worker_failure": true
    },
    "memory": {
        "working_memory_limit": 10,
        "episodic_memory_turns": 5,
        "enable_long_term": true
    },
    "reflector": {
        "enable_verification": true,
        "enable_hallucination_check": true,
        "auto_correct": true,
        "hallucination_threshold": 0.05
    },
    "tools": [
        "retrieve_tool",
        "calculator_tool",
        "compare_tool",
        "chart_tool",
        "verify_tool"
    ],
    "monitoring": {
        "enabled": true,
        "project_name": "financial-rag-agent",
        "trace_level": "detailed"
    },
    "api": {
        "_comment": "API 鉴权与安全配置",
        "key": "no-key-needed",
        "max_steps_hard_limit": 15
    }
}
