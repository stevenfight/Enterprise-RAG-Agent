# 复制为 .env.staging 后仅在隔离测试目录使用；不得提交真实值。
# 本测试 Compose 只绑定 127.0.0.1。如通过 HTTP 本机隧道验收，Cookie 必须显式关闭 Secure。
RESEARCH_SESSION_COOKIE_SECURE=false

# 首次测试登录使用的临时身份；启动前必须替换密码占位值。
RESEARCH_BOOTSTRAP_USERNAME=staging-admin
RESEARCH_BOOTSTRAP_PASSWORD=replace-before-start

# 同源 Nginx /api 代理不需要 CORS_ALLOWED_ORIGINS。不要设置为空字符串；独立 HTTPS 前端才填写精确 Origin。
# CORS_ALLOWED_ORIGINS=https://staging.example.com

# 仅在获准执行真实 Agent 请求时填写受限测试 Key；健康、登录和 CORS 验收不应依赖真实 Provider 调用。
# DASHSCOPE_API_KEY=replace-with-restricted-test-key
